# Required
ANTHROPIC_API_KEY=sk-ant-...

# Claude model
CLAUDE_MODEL=claude-sonnet-4-6

# Optional tuning
MAX_OPPORTUNITIES_PER_RUN=50
EVALUATION_BATCH_SIZE=5
MIN_FIT_SCORE=0.4
DIGEST_OUTPUT_DIR=./data/digests

# Cron schedule (default: 6 AM daily)
CRON_SCHEDULE=0 6 * * *

# Reddit config (no auth needed for public JSON)
REDDIT_USER_AGENT=ai-opportunity-scheduler/1.0

# Feature flags
ENABLE_HN_FETCH=true
ENABLE_REDDIT_FETCH=true
ENABLE_RSS_FETCH=true
