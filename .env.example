# ── LLM Provider (pick ONE — both are free, no credit card needed) ──────────
#
# OPTION A: Groq  →  sign up free at https://console.groq.com
#   - 14,400 requests/day free forever
#   - Uses Llama 3.3 70B (excellent quality)
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_...

# OPTION B: Google Gemini  →  sign up free at https://aistudio.google.com
#   - 1,500 requests/day free forever
#   - Uses Gemini 1.5 Flash (very good quality)
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=AIza...

# ── WhatsApp notifications (free: 1,000 msgs/month via Meta Cloud API) ───────
# Setup: developers.facebook.com → Create App → Add WhatsApp product
#   → WhatsApp > Getting Started → copy token + phone number ID
#   → Add your WhatsApp number as a test recipient
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=1XXXXXXXXXX

# ── Optional tuning ──────────────────────────────────────────────────────────
MAX_OPPORTUNITIES_PER_RUN=50
EVALUATION_BATCH_SIZE=5
MIN_FIT_SCORE=0.4
DIGEST_OUTPUT_DIR=./data/digests

# Cron schedule (default: 6 AM daily)
CRON_SCHEDULE=0 6 * * *

# Reddit config (no auth needed — public JSON API)
REDDIT_USER_AGENT=ai-opportunity-scheduler/1.0

# Feature flags
ENABLE_HN_FETCH=true
ENABLE_REDDIT_FETCH=true
ENABLE_RSS_FETCH=true
